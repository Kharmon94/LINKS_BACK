<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding: 40px 40px 20px 40px; background-color: #ffffff; text-align: center;">
      <h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 28px; line-height: 36px; color: #000000; font-weight: 300;">Your link is ready!</h1>
    </td>
  </tr>
  <tr>
    <td style="padding: 0 40px 40px 40px; background-color: #ffffff;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
          <td style="padding: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
            <p style="margin: 0 0 20px 0;">Hi <%= @user.name.presence || "there" %>,</p>
            <p style="margin: 0 0 30px 0;">Your short link is live and ready to share.</p>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f9f9f9; border: 1px solid #e5e5e5; margin-bottom: 30px;">
              <tr>
                <td style="padding: 25px; text-align: center;">
                  <% if @link.name.present? %>
                    <p style="margin: 0 0 8px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 12px; color: #666666; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Link</p>
                    <p style="margin: 0 0 16px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 18px; color: #000000; font-weight: 600;"><%= @link.name %></p>
                  <% end %>
                  <p style="margin: 0 0 8px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 12px; color: #666666; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Short URL</p>
                  <p style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 18px; color: #000000; font-weight: 600; word-break: break-all;"><%= @short_url %></p>
                </td>
              </tr>
            </table>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 auto 20px auto;">
              <tr>
                <td style="background-color: #000000; text-align: center;">
                  <a href="<%= @dashboard_url %>" style="background-color: #000000; border: 1px solid #000000; font-family: 'Montserrat', Arial, sans-serif; font-size: 16px; line-height: 16px; text-decoration: none; padding: 16px 40px; color: #ffffff; display: block; font-weight: 600;">Open dashboard</a>
                </td>
              </tr>
            </table>
            <p style="margin: 20px 0 0 0; font-size: 14px; color: #666666;">Use the magic link email we sent separately to access your dashboard if you are not signed in yet.</p>
            <p style="margin: 20px 0 0 0;">Thanks,<br><strong>The Links Team</strong></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
