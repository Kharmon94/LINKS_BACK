<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding: 40px 40px 20px 40px; background-color: #ffffff;">
      <h1 style="margin: 0 0 20px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 24px; line-height: 32px; color: #000000; font-weight: 600;">Contact form message</h1>
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f9f9f9; border: 1px solid #e5e5e5; margin-bottom: 24px;">
        <tr>
          <td style="padding: 20px; font-family: 'Montserrat', Arial, sans-serif; font-size: 14px; line-height: 22px; color: #333333;">
            <p style="margin: 0 0 8px 0;"><strong>From:</strong> <%= @name.presence || "(no name)" %></p>
            <p style="margin: 0;"><strong>Email:</strong> <a href="mailto:<%= @email %>" style="color: #000000;"><%= @email %></a></p>
          </td>
        </tr>
      </table>
      <p style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333; white-space: pre-wrap;"><%= @message %></p>
    </td>
  </tr>
</table>
