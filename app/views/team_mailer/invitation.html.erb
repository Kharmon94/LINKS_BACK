<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding: 40px 40px 20px 40px; background-color: #ffffff; text-align: center;">
      <h1 style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 28px; line-height: 36px; color: #000000; font-weight: 300;">You've Been Invited!</h1>
    </td>
  </tr>
  <tr>
    <td style="padding: 0 40px 40px 40px; background-color: #ffffff;">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
        <tr>
          <td style="padding: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 16px; line-height: 24px; color: #333333;">
            <p style="margin: 0 0 20px 0;">Hi there,</p>
            <p style="margin: 0 0 30px 0;"><strong><%= @inviter.name.presence || @inviter.email %></strong> (<%= @inviter.email %>) has invited you to join their team on Links.</p>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: #f9f9f9; border: 1px solid #e5e5e5; margin-bottom: 30px;">
              <tr>
                <td style="padding: 25px;">
                  <p style="margin: 0 0 5px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 12px; color: #666666; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Team</p>
                  <p style="margin: 0 0 15px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 20px; color: #000000; font-weight: 600;"><%= @team.name %></p>
                  <p style="margin: 0 0 5px 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 12px; color: #666666; text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Your Role</p>
                  <p style="margin: 0; font-family: 'Montserrat', Arial, sans-serif; font-size: 16px; color: #000000; font-weight: 600;"><%= @role %></p>
                </td>
              </tr>
            </table>
            <p style="margin: 0 0 20px 0;">As a team member, you'll be able to:</p>
            <ul style="margin: 0 0 30px 0; padding-left: 20px; font-size: 14px; line-height: 22px; color: #666666;">
              <li style="margin-bottom: 8px;">Create and manage short links</li>
              <li style="margin-bottom: 8px;">Access team campaigns and analytics</li>
              <li style="margin-bottom: 8px;">Collaborate with other team members</li>
              <li style="margin-bottom: 8px;">Use custom domains configured by your team</li>
            </ul>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 0 0 30px 0;">
              <tr>
                <td style="background-color: #000000; text-align: center;">
                  <a href="<%= @accept_url %>" style="background-color: #000000; border: 1px solid #000000; font-family: 'Montserrat', Arial, sans-serif; font-size: 16px; line-height: 16px; text-decoration: none; padding: 16px 40px; color: #ffffff; display: block; font-weight: 600;">Accept Invitation</a>
                </td>
              </tr>
            </table>
            <p style="margin: 0 0 20px 0; font-size: 14px; color: #666666;">Or copy and paste this link into your browser:</p>
            <p style="margin: 0 0 30px 0; padding: 15px; background-color: #f9f9f9; border: 1px solid #e5e5e5; word-break: break-all; font-size: 14px; color: #666666; font-family: monospace;"><%= @accept_url %></p>
            <p style="margin: 0 0 20px 0; font-size: 14px; color: #666666;">This invitation will expire in <strong><%= @expiry_days %> days</strong>.</p>
            <p style="margin: 20px 0 0 0; font-size: 14px; color: #666666;">If you weren't expecting this invitation, you can safely ignore this email.</p>
            <p style="margin: 20px 0 0 0;">Thanks,<br><strong>The Links Team</strong></p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
