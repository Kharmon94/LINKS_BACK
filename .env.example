# Core
RAILS_ENV=development
SECRET_KEY_BASE=
DEVISE_JWT_SECRET_KEY=

# Origins
FRONTEND_ORIGIN=http://localhost:5173

# Mail
MAILER_FROM=noreply@example.com
CONTACT_INBOX_EMAIL=support@example.com

# Google OAuth (Devise / OmniAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.com

# Admin seed (production deploy)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# Short links in API JSON responses
SHORT_LINK_HOST=links.blackcollar.io

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_LIVE=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_LIVE=
STRIPE_LIVE_MODE=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=

# Cron
CRON_SECRET=

# SendGrid (production)
SENDGRID_API_KEY=
APP_HOST=
MAILER_HOST=

# AWS S3 Active Storage (production)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET=

# Postgres (production)
DATABASE_URL=

# Redis (optional; Solid* used when unset)
REDIS_URL=
